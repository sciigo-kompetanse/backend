# Build/runtime artifacts that should never end up in the production image.

# Dependencies — re-installed inside the image via `npm ci`.
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Source control / editor cruft
.git
.gitignore
.gitattributes
.editorconfig
.vscode
.idea
*.swp
.DS_Store

# Local env — Fleet injects env vars at runtime. Anything committed by accident
# stays out of the image so it can't shadow the injected values.
.env
.env.*
!.env.docker.example
!.env.example

# NOTE: server.crt / server.key were *previously* excluded, but src/proxy.js
# hard-loads them at boot via readFileSync(). The app crashes (ENOENT) without
# them. They're committed self-signed dev certs and only terminate the
# proxy's internal HTTPS port — Fleet's Traefik handles real public-facing
# TLS, so these never face the internet. Leaving them in the image is fine.
# If you ever make proxy.js's TLS optional, you can re-add the excludes here.
# *.pem

# Local-only data dirs (the docker-compose volume mount target).
sites
domains
temp
logs

# Tests + docs don't need to be inside the running container.
test
*.md
!README.md

# CI / tooling configs
.eslintrc*
.prettierrc*
.github
.gitlab-ci.yml
